# ============================================================
# 赛事复用配置模板
# 用法：复制为 .env（docker compose 会自动读取），按需修改
# 配置优先级：后台「赛事设置」(数据库) > .env / 环境变量 > 代码默认值
# ============================================================

# ---- 赛事标识 ----
EVENT_NAME=冷水坑杯
EVENT_TIMEZONE=Asia/Shanghai
SEASON_NUMBER=3
# 完整赛事名，留空则自动拼成 "{EVENT_NAME} #{SEASON_NUMBER}"；首次建库后以数据库为准
# TOURNAMENT_NAME=冷水坑杯 #3

# ---- 队伍与位置 ----
TEAM_SIZE=4
TEAM_POSITIONS=cold,normal1,normal2,pit

# ---- 页面术语（只影响文案，模型结构不变） ----
TRACK_LABEL=肉鸽
MEMBER_FIELD1_LABEL=分队
MEMBER_FIELD2_LABEL=开局干员

# ---- 赛制默认值 ----
SCHEDULE_SLOT_TIMES=14:00,19:00
SCHEDULE_SLOT_MINUTES=120
DEFAULT_BONUS_SCORE=500
DEFAULT_DIFFICULTY_MIN=12
DEFAULT_DIFFICULTY_MAX=18
DEFAULT_DIFFICULTY_STEP=0.1

# ---- 品牌 ----
BRAND_PRIMARY_COLOR="#0d6efd"

# ---- 运行时 ----
PORT=19198
WEB_WORKERS=4
# 生产启动前填写独立的随机会话密钥。
SECRET_KEY=
FLASK_ENV=production

# ---- 初始账号（仅 prepare 初始化空赛事库时创建） ----
ADMIN_USERNAME=admin
# 生产启动前填写。既有账号使用数据库中的密码。
ADMIN_PASSWORD=
# 超级管理员：留空则不创建
# SUPER_ADMIN_USERNAME=
# SUPER_ADMIN_PASSWORD=

# ---- 数据库 ----
# 原生默认使用 SQLite。原生 MySQL 请设置 DB_BACKEND=mysql 及 MYSQL_HOST/MYSQL_PORT。
# DB_BACKEND=mysql
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3306
# 显式 DATABASE_URL 优先。MySQL Compose 默认使用下面的独立库名、用户和口令。
# DATABASE_URL=

# ---- 部署（仅 docker-compose 使用） ----
IMAGE=sahuhh/lskb-app
IMAGE_TAG=3.0
# MYSQL_IMAGE=mysql:8.0
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=lskb_signup
MYSQL_USER=lskb
MYSQL_PASSWORD=
# 仅叠加 docker-compose.mysql-port.yml 时使用，绑定到宿主机 127.0.0.1
# MYSQL_PUBLISH_PORT=3307
# 需要与旧实例并存时设置，compose 会给卷/网络自动加前缀
# COMPOSE_PROJECT_NAME=lskb4
# Compose 宿主机轮播素材目录，容器内只读挂载到 /app/image
# IMAGE_HOST_DIR=./image


# 原生部署：默认使用项目内的 .db/lskb.db、app/static/uploads 和 image。
# 覆盖时建议导出绝对路径；沿用已有数据库时填写其实际位置。
# DB_FILE=/srv/lskb/event4/db/lskb.db
# UPLOAD_ROOT=/srv/lskb/event4/uploads
# IMAGE_DIR=/srv/lskb/event4/image
# STATE_DIR=.runtime
# BACKUP_DIR=backups
# 原生进程导出此值，Compose 构建时写入镜像。已有镜像使用构建时记录的版本。
APP_VERSION=account-privacy-v1
# LEGACY_APP_VERSION=8238f20
