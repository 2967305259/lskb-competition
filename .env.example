# ============================================================
# 赛事复用配置模板
# 用法：复制为 .env（docker compose 会自动读取），按需修改
# 配置优先级：后台「赛事设置」(数据库) > .env / 环境变量 > 代码默认值
# ============================================================

# ---- 赛事标识 ----
EVENT_NAME=冷水坑杯
SEASON_NUMBER=3
# 完整赛事名，留空则自动拼成 "{EVENT_NAME} #{SEASON_NUMBER}"；首次建库后以数据库为准
# TOURNAMENT_NAME=冷水坑杯 #3

# ---- 队伍与位置 ----
TEAM_SIZE=4
TEAM_POSITIONS=cold,normal1,normal2,pit

# ---- 页面术语（只影响文案，模型结构不变） ----
TRACK_LABEL=肉鸽
MEMBER_FIELD1_LABEL=分队
MEMBER_FIELD2_LABEL=开局干员

# ---- 赛制默认值 ----
SCHEDULE_SLOT_TIMES=14:00,19:00
SCHEDULE_SLOT_MINUTES=120
DEFAULT_BONUS_SCORE=500
DEFAULT_DIFFICULTY_MIN=12
DEFAULT_DIFFICULTY_MAX=18
DEFAULT_DIFFICULTY_STEP=0.1

# ---- 品牌 ----
BRAND_PRIMARY_COLOR="#0d6efd"

# ---- 运行时 ----
PORT=19198
# 生产环境务必改成随机长字符串
SECRET_KEY=change-me-in-production
FLASK_ENV=production

# ---- 初始账号（仅首次启动创建） ----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
# 超级管理员：留空则不创建
# SUPER_ADMIN_USERNAME=
# SUPER_ADMIN_PASSWORD=

# ---- 数据库 ----
# 留空 = 使用本地 SQLite（.db/lskb.db）
# 使用 docker-compose 内置 MySQL 时不要覆盖本项，compose 会自动拼出连接串
# DATABASE_URL=mysql+pymysql://lskb:lskb123@mysql:3306/lskb_signup?charset=utf8mb4

# ---- 部署（仅 docker-compose 使用） ----
IMAGE=sahuhh/lskb-app
IMAGE_TAG=3.0
CONTAINER_NAME=lskb-app
MYSQL_CONTAINER_NAME=lskb-mysql
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=lskb_signup
MYSQL_USER=lskb
MYSQL_PASSWORD=lskb123
# 需要与旧实例并存时设置，compose 会给卷/网络自动加前缀
# COMPOSE_PROJECT_NAME=lskb4
